# Netlify reads this from the published folder (crm/).
#
# The app has no build step, so js/app.js and css/crm.css keep the same URL for
# ever. Without a rule here, a phone that has done "Add to Home Screen" happily
# serves yesterday's copy and a fix that shipped correctly looks like it never
# shipped at all.
#
# max-age=0 with must-revalidate still lets the browser keep the file; it just
# has to ask "has this changed?" before using it. The usual answer is a 304 with
# no body, so this costs a round trip rather than a download.

/*
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: no-cache

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

# The fonts and the logo are the same bytes for ever, so let those cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800
